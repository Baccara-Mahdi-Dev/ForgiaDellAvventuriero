{
  "name": "ForgiaAvventuriero",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "catalog:editor": "node tools/catalog-editor/server.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "check:app": "npm run validate:data && npm run test:ci",
    "build:netlify": "npm run check:app && npm run build && node scripts/generate-public-metadata.mjs",
    "verify": "npm run validate:data && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@ng-icons/core": "^33.0.0",
    "@ng-icons/game-icons": "^33.0.0",
    "@ng-icons/simple-icons": "^35.0.1",
    "@taiga-ui/cdk": "^5.18.0",
    "@taiga-ui/core": "^5.18.0",
    "@taiga-ui/icons": "^5.18.0",
    "@taiga-ui/kit": "^5.18.0",
    "@tailwindcss/postcss": "^4.3.3",
    "ajv": "^8.20.0",
    "dexie": "^4.4.4",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "postcss": "^8.5.25",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.0",
    "@types/pdfmake": "^0.3.3",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
